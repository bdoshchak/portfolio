1260 0 obj
  << /ActualText (What style is the most suitable\077)
     /K [ 10 ]
     /P 1261 0 R
     /Pg 1240 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

1261 0 obj
  << /K [ 1260 0 R ]
     /P 1292 0 R
     /S /P
     /Pg 1240 0 R
     /Type /StructElem
  >>
endobj

1262 0 obj
  << /ActualText (The leading principle is to prioritize legibility and simplicity whenever feasible\056\050\050The most appropriate choice depends on the number of charts and metrics on the section\054 together with the type of chart being used\056\050\050For basic charts\054 a Monochrome style with default colors must be preferred\056\050\050In case of multiple charts with 1\0553 metrics\054 the Monochrome style can still be used\054 but the default colors should be modified for each chart\056 \050\050When dealing with more than six metrics \050lines\054 bars\054 etc\056\051 in a single chart\054 the Ten\055color Style is the most appropriate choice\056)
     /K [ 11 ]
     /P 1263 0 R
     /Pg 1240 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

